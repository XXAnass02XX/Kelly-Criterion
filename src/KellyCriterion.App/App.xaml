<Application x:Class="KellyCriterion.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KellyCriterion.App.ViewModels"
             xmlns:views="clr-namespace:KellyCriterion.App.Views"
             xmlns:fmt="clr-namespace:KellyCriterion.App.Formatting">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <fmt:CompactNumberConverter x:Key="CompactNumber" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <DataTemplate DataType="{x:Type vm:SimulationSetupViewModel}">
                <views:SimulationSetupView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SimulationResultsViewModel}">
                <views:SimulationResultsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
