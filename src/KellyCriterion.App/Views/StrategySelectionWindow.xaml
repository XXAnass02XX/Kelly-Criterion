<Window x:Class="KellyCriterion.App.Views.StrategySelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:KellyCriterion.App.Views"
        mc:Ignorable="d"
        Title="Choose a strategy"
        Width="360" Height="220"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="Which betting strategy do you want to use?"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />
        <Button Content="Kelly"
                Height="36"
                Margin="0,0,0,8"
                Click="KellyButton_Click" />
        <Button Content="Half Kelly"
                Height="36"
                Click="HalfKellyButton_Click" />
    </StackPanel>
</Window>
