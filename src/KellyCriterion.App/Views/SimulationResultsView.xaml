<UserControl x:Class="KellyCriterion.App.Views.SimulationResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KellyCriterion.App.ViewModels"
             xmlns:charting="clr-namespace:KellyCriterion.App.Charting"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SimulationResultsViewModel}"
             d:DesignWidth="1200" d:DesignHeight="750"
             Focusable="True"
             Loaded="OnLoaded">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
        <KeyBinding Key="Backspace" Command="{Binding BackCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="270" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,16" LastChildFill="True">
            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="←  New simulation"
                    Command="{Binding BackCommand}" Margin="0,0,16,0" ToolTip="Back to the input form (Esc)" />
            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Content="Logarithmic scale"
                      IsChecked="{Binding UseLogScale}" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Title}" FontSize="19" Foreground="{StaticResource AccentGradientBrush}"
                           Text="Portfolio evolution" />
                <TextBlock Style="{StaticResource Subtitle}" Text="{Binding Headline}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="86,2,0,8">
                    <Rectangle Width="7" Height="7" RadiusX="2" RadiusY="2" Fill="#6366F1" Opacity="0.6" VerticalAlignment="Center" />
                    <Rectangle Width="7" Height="7" RadiusX="2" RadiusY="2" Fill="#EC4899" Opacity="0.6" Margin="2,0" VerticalAlignment="Center" />
                    <Rectangle Width="7" Height="7" RadiusX="2" RadiusY="2" Fill="#14B8A6" Opacity="0.6" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,18,0" Style="{StaticResource StatLabel}" Text="Individual runs (50% opacity)" />
                    <Rectangle Width="22" Height="3" Fill="{StaticResource AverageLineBrush}" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,18,0" Style="{StaticResource StatLabel}" Text="Average of all runs" />
                    <Rectangle Width="22" Height="3" Fill="#16A34A" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,18,0" Style="{StaticResource StatLabel}" Text="Median of all runs" />
                    <Line X1="0" X2="22" Stroke="#94A3B8" StrokeThickness="1.2" StrokeDashArray="3 2" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,0,0" Style="{StaticResource StatLabel}" Text="Initial portfolio" />
                </StackPanel>

                <charting:WealthChart Grid.Row="1"
                                      Paths="{Binding WealthPaths}"
                                      AveragePath="{Binding AvgWealthPath}"
                                      MedianPath="{Binding MedianWealthPath}"
                                      IsLogarithmic="{Binding UseLogScale}"
                                      ReferenceValue="{Binding InitialWealth}"
                                      RunOpacity="0.5"
                                      AverageBrush="{StaticResource AverageLineBrush}"
                                      MedianBrush="{StaticResource MedianLineBrush}"
                                      PlotBackground="{StaticResource PlotBackgroundBrush}"
                                      XAxisTitle="Gamble number"
                                      YAxisTitle="Portfolio value" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource StatTile}" Background="#EEF2FF" BorderBrush="#6366F1">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="Kelly fraction wagered" />
                            <TextBlock Style="{StaticResource StatValue}" Foreground="#4F46E5"
                                       Text="{Binding Result.WagerFraction, StringFormat={}{0:P2}}" />
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="10" Padding="10,8" Margin="0,0,0,8" Background="#FEF3C7">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEdge}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#92400E"
                                   Text="No positive edge: the Kelly Criterion says not to bet, so the portfolio stays flat." />
                    </Border>

                    <Border Style="{StaticResource StatTile}" Background="#F5F3FF" BorderBrush="#8B5CF6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="Initial portfolio" />
                            <TextBlock Style="{StaticResource StatValue}" Foreground="#6D28D9"
                                       Text="{Binding InitialWealth, Converter={StaticResource CompactNumber}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatTile}" Background="#FDF2F8" BorderBrush="#EC4899">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="Average final portfolio" />
                            <TextBlock Style="{StaticResource StatValue}" Foreground="#BE185D"
                                       Text="{Binding Summary.AvgFinalWealth, Converter={StaticResource CompactNumber}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatTile}" Background="#F0F9FF" BorderBrush="#0EA5E9">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="Median final portfolio" />
                            <TextBlock Style="{StaticResource StatValue}" Foreground="#0369A1"
                                       Text="{Binding Summary.MedianFinalWealth, Converter={StaticResource CompactNumber}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatTile}" Background="#F0FDFA" BorderBrush="#14B8A6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="Theoretical median  W₀·e^(N·G)" />
                            <TextBlock Style="{StaticResource StatValue}" Foreground="#0F766E"
                                       Text="{Binding TheoreticalMedianFinalWealth, Converter={StaticResource CompactNumber}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatTile}" Background="#FFFBEB" BorderBrush="#F59E0B">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="Expected log-growth per gamble (G)" />
                            <TextBlock Style="{StaticResource StatValue}" Foreground="#B45309"
                                       Text="{Binding Result.ExpectedLogGrowthPerGamble, StringFormat={}{0:0.#####}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatTile}" Background="#FFF1F2" BorderBrush="#F43F5E">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="Worst / best final portfolio" />
                            <TextBlock Style="{StaticResource StatValue}" Foreground="#BE123C">
                                <Run Text="{Binding Summary.MinFinalWealth, Converter={StaticResource CompactNumber}, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding Summary.MaxFinalWealth, Converter={StaticResource CompactNumber}, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatTile}" Background="#ECFDF5" BorderBrush="#10B981">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="Runs ending in profit" />
                            <TextBlock Style="{StaticResource StatValue}" Foreground="#047857"
                                       Text="{Binding Summary.ProfitableRunsRatio, StringFormat={}{0:P1}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
