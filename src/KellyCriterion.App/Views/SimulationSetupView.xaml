<UserControl x:Class="KellyCriterion.App.Views.SimulationSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:KellyCriterion.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SimulationSetupViewModel}"
             d:DesignWidth="900" d:DesignHeight="800"
             FocusManager.FocusedElement="{Binding ElementName=RunsBox}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="560" Margin="16" Padding="0"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Border Background="{StaticResource AccentGradientBrush}" CornerRadius="13,13,0,0" Padding="28,20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Foreground="White" Text="Kelly Criterion Simulator" />
                        <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="#E0E7FF" TextWrapping="Wrap"
                                   Text="Simulate how a gambler's portfolio evolves when every bet stakes the Kelly fraction of its current value." />
                    </StackPanel>
                </Border>

                <Grid Margin="28,22,28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Number of runs" />
                        <TextBlock Style="{StaticResource FieldHint}" Text="Independent gamblers to simulate." />
                        <TextBox x:Name="RunsBox" Margin="0,0,0,30"
                                 Text="{Binding Runs, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Number of gambles (N)" />
                        <TextBlock Style="{StaticResource FieldHint}" Text="Bets placed by each gambler." />
                        <TextBox Margin="0,0,0,30" Text="{Binding Gambles, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Probability of winning (p)" />
                        <TextBlock Style="{StaticResource FieldHint}" Text="Between 0 and 1, e.g. 0.6." />
                        <TextBox Margin="0,0,0,30" Text="{Binding WinProbability, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Payout ratio (b)" />
                        <TextBlock Style="{StaticResource FieldHint}" Text="Net win per 1 unit staked, e.g. 1." />
                        <TextBox Margin="0,0,0,30" Text="{Binding PayoutRatio, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Initial portfolio value" />
                        <TextBlock Style="{StaticResource FieldHint}" Text="Amount each gambler starts with." />
                        <TextBox Margin="0,0,0,30" Text="{Binding InitialWealth, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.ColumnSpan="3">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Betting strategy" />
                        <TextBlock Style="{StaticResource FieldHint}" Text="How much of the portfolio each bet stakes." />
                        <ComboBox Margin="0,0,0,30"
                                  ItemsSource="{Binding Strategies}"
                                  SelectedItem="{Binding SelectedStrategy}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Border Grid.Row="4" Grid.ColumnSpan="3" Background="{StaticResource SoftAccentBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14,10" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Fraction to wager" />
                                <TextBlock Style="{StaticResource StatLabel}" Text="{Binding SelectedStrategy.Name}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentGradientBrush}"
                                       Text="{Binding KellyFractionPreview, StringFormat={}{0:P2}, TargetNullValue=—}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,0,0,16">
                        <Grid Margin="0,0,0,6">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatLabel}">
                                        <Setter Property="Text" Value="Press Simulate to start" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SimulateCommand.IsRunning}" Value="True">
                                                <Setter Property="Text" Value="Simulating…" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="{Binding Progress, StringFormat={}{0} %}" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Margin="0,0,0,12"
                               Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                               Text="{Binding ErrorMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Grid.Row="7" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Subtitle}" VerticalAlignment="Center" Text="Press Enter to simulate" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="0,0,8,0"
                                    IsCancel="True"
                                    Command="{Binding SimulateCancelCommand}"
                                    Visibility="{Binding SimulateCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Simulate  →" IsDefault="True"
                                    Command="{Binding SimulateCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
